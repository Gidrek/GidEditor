<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:GidEditor.Views"
        xmlns:svc="using:GidEditor.Services"
        xmlns:md="using:GidEditor.Markdown"
        x:Class="GidEditor.Views.AboutWindow"
        x:DataType="views:AboutWindow"
        Title="About GidEditor"
        Width="640" Height="720" MinWidth="440" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/gideditor.ico"
        Background="{DynamicResource Gid.Background}">

    <Window.Styles>
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="SelectableTextBlock.license">
            <Setter Property="FontFamily" Value="{x:Static md:EditorFonts.Mono}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Gid.CodeBlockText}" />
        </Style>
        <Style Selector="Border.license-box">
            <Setter Property="Background" Value="{DynamicResource Gid.CodeBackground}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource Gid.SurfaceActive}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Gid.Accent}" />
        </Style>
    </Window.Styles>

    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,28,32,32" MaxWidth="620" Spacing="0">

            <!-- App header -->
            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,20">
                <Image Source="/Assets/gideditor.png" Width="72" Height="72" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Margin="18,4,0,0" Spacing="4">
                    <TextBlock Text="GidEditor" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Gid.Heading}" />
                    <TextBlock Classes="muted" FontSize="13" Text="{Binding VersionText}" />
                    <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="Markdown notes that live in a folder you own." />
                </StackPanel>
            </Grid>

            <Expander Margin="0,0,0,28">
                <Expander.Header>
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="© 2026 Giovanni Cortes" FontWeight="SemiBold" />
                            <TextBlock Classes="muted" FontSize="12" Text="GidEditor is open source software" />
                        </StackPanel>
                        <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0">
                            <TextBlock Text="MIT" />
                        </Border>
                    </Grid>
                </Expander.Header>
                <Border Classes="license-box">
                    <SelectableTextBlock Classes="license" Text="{Binding AppLicense}" />
                </Border>
            </Expander>

            <!-- Third-party credits -->
            <TextBlock Classes="section-title" Text="OPEN SOURCE LICENSES" Margin="2,0,0,6" />
            <TextBlock Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="2,0,0,14" LineHeight="20"
                       Text="GidEditor is built with these open source projects. Thank you to everyone who makes them." />

            <ItemsControl ItemsSource="{Binding Components}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="svc:OpenSourceComponent">
                        <Expander>
                            <Expander.Header>
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Classes="muted" FontSize="12" Text="{Binding Description}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0">
                                        <TextBlock Text="{Binding License}" />
                                    </Border>
                                </Grid>
                            </Expander.Header>
                            <StackPanel Spacing="8">
                                <HyperlinkButton Content="{Binding Url}" NavigateUri="{Binding Uri}" Padding="0" FontSize="12" />
                                <Border Classes="license-box">
                                    <SelectableTextBlock Classes="license" Text="{Binding DisplayText}" />
                                </Border>
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="2,14,0,0"
                       Text="These notices are also included as THIRD-PARTY-NOTICES.txt next to the application." />
        </StackPanel>
    </ScrollViewer>
</Window>
